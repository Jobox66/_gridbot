# Thông tin kết nối tài khoản MetaTrader 5 (Exness Cent)
# Đổi tên file này thành .env và điền các thông tin thật của bạn vào.

MT5_LOGIN=12345678
MT5_PASSWORD=your_trading_password
MT5_SERVER=Exness-MT5Trial

# Cặp tiền tệ bạn muốn Trade (ví dụ: AUDNZDm đối với tài khoản Cent)
SYMBOL=AUDNZDm

# Magic Number để bot nhận diện lệnh do chính nó mở
MAGIC_NUMBER=999999
